#!/usr/bin/env bash

set -euo pipefail

plugins_dir="$HOME/.config/omarchy/plugins"
results='[]'

append_result() {
  local id="$1"
  local status="$2"
  local local_commit="${3:-}"
  local remote_commit="${4:-}"
  local error="${5:-}"
  results=$(jq -cn \
    --argjson current "$results" \
    --arg id "$id" \
    --arg status "$status" \
    --arg localCommit "$local_commit" \
    --arg remoteCommit "$remote_commit" \
    --arg error "$error" \
    '$current + [{id: $id, status: $status, localCommit: $localCommit,
      remoteCommit: $remoteCommit, error: $error}]')
}

remote_is_safe() {
  [[ $1 =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(\.git)?$ \
    || $1 =~ ^git@github\.com:[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(\.git)?$ \
    || $1 =~ ^ssh://git@github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(\.git)?$ ]]
}

export GIT_TERMINAL_PROMPT=0
export GIT_ASKPASS=/bin/false
export GIT_SSH_COMMAND="ssh -oBatchMode=yes -oStrictHostKeyChecking=yes -oConnectTimeout=10"
deadline=$((SECONDS + 60))

for id in "$@"; do
  if [[ ! $id =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || $id == *..* ]]; then
    append_result "$id" error "" "" "Invalid plugin id."
    continue
  fi

  plugin_dir="$plugins_dir/$id"
  if [[ ! -d $plugin_dir/.git ]]; then
    append_result "$id" unsupported "" "" "Plugin is not Git managed."
    continue
  fi

  local_commit=$(git -C "$plugin_dir" rev-parse HEAD 2>/dev/null || true)
  if [[ ! $local_commit =~ ^[0-9a-f]{40,64}$ ]]; then
    append_result "$id" error "" "" "Could not read the local commit."
    continue
  fi

  remote=$(git -C "$plugin_dir" remote get-url origin 2>/dev/null || true)
  if ! remote_is_safe "$remote"; then
    append_result "$id" unsupported "$local_commit" "" "Origin is not a supported GitHub URL."
    continue
  fi

  remaining=$((deadline - SECONDS))
  if (( remaining <= 0 )); then
    append_result "$id" error "$local_commit" "" "Update check exceeded its overall time limit."
    continue
  fi
  (( remaining > 12 )) && remaining=12
  remote_output=$(timeout --signal=TERM --kill-after=2s "$remaining" \
    git -c credential.helper= -c core.askPass=/bin/false \
      ls-remote --exit-code "$remote" HEAD 2>/dev/null || true)
  read -r remote_commit _ <<<"$remote_output"
  if [[ ! $remote_commit =~ ^[0-9a-f]{40,64}$ ]]; then
    append_result "$id" error "$local_commit" "" "Could not query the remote commit."
    continue
  fi

  if [[ $local_commit == "$remote_commit" ]]; then
    append_result "$id" current "$local_commit" "$remote_commit"
  elif git -C "$plugin_dir" cat-file -e "$remote_commit^{commit}" 2>/dev/null; then
    if git -C "$plugin_dir" merge-base --is-ancestor "$remote_commit" "$local_commit" 2>/dev/null; then
      append_result "$id" error "$local_commit" "$remote_commit" "Local checkout is ahead of the remote."
    elif git -C "$plugin_dir" merge-base --is-ancestor "$local_commit" "$remote_commit" 2>/dev/null; then
      append_result "$id" available "$local_commit" "$remote_commit"
    else
      append_result "$id" error "$local_commit" "$remote_commit" "Local and remote histories have diverged."
    fi
  else
    append_result "$id" available "$local_commit" "$remote_commit"
  fi
done

jq -cn --argjson plugins "$results" '{schemaVersion: 1, plugins: $plugins}'
